{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx4g"
        }
      },
      "prebuildCommand": "node unified-build-patch.js",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "@SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY",
        "EXPO_ACCESS_TOKEN": "@EXPO_ACCESS_TOKEN",
        "BRANCH_API_KEY": "@BRANCH_API_KEY",
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICES_PLIST"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx4g"
        }
      },
      "prebuildCommand": "node unified-build-patch.js",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "@SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY",
        "EXPO_ACCESS_TOKEN": "@EXPO_ACCESS_TOKEN",
        "BRANCH_API_KEY": "@BRANCH_API_KEY",
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICES_PLIST"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android": {
        "credentialsSource": "remote",
        "buildType": "app-bundle",
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.project.org.gradle.internal.publish.checksums.insecure=true -Dorg.gradle.jvmargs=-Xmx4g"
        }
      },
      "prebuildCommand": "node unified-build-patch.js",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "@SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@SUPABASE_ANON_KEY",
        "EXPO_ACCESS_TOKEN": "@EXPO_ACCESS_TOKEN",
        "BRANCH_API_KEY": "@BRANCH_API_KEY",
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICES_PLIST"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest",
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.project.org.gradle.internal.publish.checksums.insecure=true -Dorg.gradle.jvmargs=-Xmx4g"
        }
      },
      "prebuildCommand": "node unified-build-patch.js"
    },
    "production-apk-clean": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest",
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx4g"
        }
      },
      "prebuildCommand": "node -e \"console.log('Building with clean configuration, using unified patch system with minimal fixes');\""
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
